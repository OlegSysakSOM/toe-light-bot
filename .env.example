# Токен від @BotFather
TELEGRAM_BOT_TOKEN=

# Куди слати. Можна лишити порожнім: напишіть боту /start, і бот сам знайде ваш чат
TELEGRAM_CHAT_ID=

# Ключ вашої адреси: cityId/streetId/будинок  (див. README, крок 3)
# Наприклад: 12345/6789/24   — або base64-значення заголовка X-debug-key
TOE_ADDRESS=

# Ваша підчерга (вкажіть свою)
GROUP=5.1

# Підпис адреси на картинці
ADDRESS_LABEL=Моя адреса

# Як часто перевіряти сайт, секунд (900 = 15 хв)
CHECK_INTERVAL_SECONDS=900
TIMEZONE=Europe/Kyiv

# 1 = при новому повідомленні про зміну видаляти попереднє (чат без «історії»)
DELETE_PREVIOUS=0

# Лише для Docker/хмари (в Dockerfile вже виставлено): де зберігати стан і чи писати лог у файл
# STATE_FILE=data/state.json
# LOG_FILE=

# Для GitHub Actions: Fernet-ключ шифрування state.enc (створити командою з README)
# STATE_ENCRYPTION_KEY=
